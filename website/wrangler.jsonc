{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localrecall",
  "main": "worker.js",
  "compatibility_date": "2026-02-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "localrecall.andacbasaran.com",
      "custom_domain": true
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ]
}
